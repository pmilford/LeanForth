== 7. symbolic mode (question 4(b)), clamp and examples
sym lf-clamp  (3 inputs)
  when (lower > upper):  false
  when not (lower > upper):  min(max(value, lower), upper) true
outcome 0 
sym lf-example-max = rshift(-1, 1)
sym lf-example-min = invert(lf-example-max)
sym lf-add-above?  (2 inputs)
  when always:  (a > (lf-example-max - b))
sym lf-add-below?  (2 inputs)
  when always:  (a < (lf-example-min - b))
sym lf-add-overflow?  (2 inputs)
  when (b > 0):  (a > (lf-example-max - b))
  when not (b > 0):  (if (b < 0) then (a < (lf-example-min - b)) else false)
sym lf-checked-add  (2 inputs)
  when not (if (b > 0) then (a > (lf-example-max - b)) else (if (b < 0) then (a < (lf-example-min - b)) else false)):  (a + b) true
  when (if (b > 0) then (a > (lf-example-max - b)) else (if (b < 0) then (a < (lf-example-min - b)) else false)):  false
sym lf-checked-abs  (1 inputs)
  when not (n = lf-example-min):  abs(n) true
  when (n = lf-example-min):  false
sym lf-product-over?  (2 inputs)
  when always:  (product > (lf-example-max / n))
sym lf-factorial-from: unsupported: a loop: needs an invariant (plan 4.4.1)
sym lf-factorial: unsupported: calls a word that is not supported
sym lf-euclid: unsupported: a loop: needs an invariant (plan 4.4.1)
sym lf-gcd: unsupported: calls a word that is not supported
sym lf-within-closed?  (3 inputs)
  when always:  (not (lower > value) and not (value > upper))
sym lf-in-range  (3 inputs)
  when not (lower > upper):  (not (lower > value) and not (value > upper)) true
  when (lower > upper):  false
outcome 0 
