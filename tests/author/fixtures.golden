== 09a-chain-draft
ran: ok
lean: theorem chain : ∀ {A B C D : Prop}, (A → B) → (B → C) → (C → D) → A → D :=
lean: fun {A B C D} f g h a ↦ h (g (f a))
note: chain/to-B (line 12), by an AI: f turns the proof a of A into a proof of B
note: chain/to-C (line 13), by an AI: g turns that into a proof of C
note: chain/to-D (line 14), by a person: h finishes the chain: a proof of D
words:
theorem chain
  Prop implicit: A
  Prop implicit: B
  Prop implicit: C
  Prop implicit: D
  A B -> explicit: f
  B C -> explicit: g
  C D -> explicit: h
  A D ->
:=
  A explicit: a h g f a $ label: to-B ai-note" f turns the proof a of A into a proof of B"
    $ label: to-C ai-note" g turns that into a proof of C"
    $ label: to-D note" h finishes the chain: a proof of D"
    fun
end chain
