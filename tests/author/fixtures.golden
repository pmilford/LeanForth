words:
theorem MyMonoid.mul_one'
  universe u
  u Type implicit: M
  MyMonoid u ^ M $ instance: inst
  M explicit: a
  Eq u 1 level+ ^ M $ MyMonoid.mul u ^ M $ inst $ a $ MyMonoid.one u ^ M $ inst $ $ $ a $
:=
  MyMonoid.mul_one u ^ M $ inst $ a $
end MyMonoid.mul_one'
