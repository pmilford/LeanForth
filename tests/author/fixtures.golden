== 09b-chain-edit
ran: ok
lean: theorem composition : ∀ {A B C : Prop}, (A → B) → (B → C) → A → C :=
lean: fun {A B C} f g value ↦ g (f value)
lean: theorem chain : ∀ {A B C D : Prop}, (A → B) → (B → C) → (C → D) → A → D :=
lean: fun {A B C D} f g h a ↦ h (composition f g a)
note: chain/to-C (line 24), by a person: composition does the first two steps at once
note: chain/to-D (line 25), by a person: h finishes the chain: a proof of D
words:
theorem composition
  Prop implicit: A
  Prop implicit: B
  Prop implicit: C
  A B -> explicit: f
  B C -> explicit: g
  A C ->
:=
  A explicit: value g f value $ $ fun
end composition

theorem chain
  Prop implicit: A
  Prop implicit: B
  Prop implicit: C
  Prop implicit: D
  A B -> explicit: f
  B C -> explicit: g
  C D -> explicit: h
  A D ->
:=
  A explicit: a h composition A $ B $ C $ f $ g $ a $ label: to-C
    note" composition does the first two steps at once"
    $ label: to-D note" h finishes the chain: a proof of D"
    fun
end chain
