words:
theorem add_comm'
  Nat explicit: n
  Nat explicit: m
  Eq 1 ^ Nat $ HAdd.hAdd 0 ^ 0 ^ 0 ^ Nat $ Nat $ Nat $ instHAdd 0 ^ Nat $ instAddNat $ $ n
    $ m $ $ HAdd.hAdd 0 ^ 0 ^ 0 ^ Nat $ Nat $ Nat $ instHAdd 0 ^ Nat $ instAddNat $ $ m $
    n $ $
:=
  Nat.add_comm n $ m $
end add_comm'
