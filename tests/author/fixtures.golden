words:
def Big
  universe u
  u 1 level+ Type
:=
  u Type
end Big

def PairSort
  universe u
  universe v
  u Sort explicit: _A
  v Sort explicit: _B
  u v level-max Type
:=
  u v level-max Sort
end PairSort

def ImaxSort
  universe u
  universe v
  u Sort explicit: _A
  v Sort explicit: _B
  u v level-imax Type
:=
  u v level-imax Sort
end ImaxSort

def PairOf
  universe u
  universe v
  u Sort explicit: A
  v Sort explicit: B
  u v level-max Type
:=
  PairSort v ^ u ^ B $ A $
end PairOf
