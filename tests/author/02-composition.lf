kernel-form \ Lean: theorem composition {A B C : Prop} (f : A → B) (g : B → C) : A → C :=
\         fun value => g (f value)
theorem composition
  Prop implicit: A   Prop implicit: B   Prop implicit: C
  A B ->  explicit: f
  B C ->  explicit: g
  A C ->
:=
  A explicit: value   g f value $ $   fun
end composition
