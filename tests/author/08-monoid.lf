kernel-form \ Lean: universe u
\       class MyMonoid (M : Type u) where
\         mul : M → M → M
\         one : M
\         mul_one : ∀ a : M, mul a one = a
\       namespace MyMonoid
\       theorem mul_one' {M : Type u} [inst : MyMonoid M] (a : M) : mul a one = a :=
\         mul_one a
\       end MyMonoid
\ The class is a library here (plan task 8.2.1d): its export, made by Lean
\ from the class alone, holds MyMonoid, its fields, Eq and the rest they
\ need (tests/author/monoid-slice.ndjson):
\   leanforth check --env tests/author/monoid-slice.ndjson tests/author/08-monoid.lf
\ The library's export does not say which constants are protected, so its
\ constants are written by their full names inside the namespace too.
namespace MyMonoid
theorem mul_one'
  universe u
  u Type implicit: M
  MyMonoid u ^ M $  instance: inst
  M explicit: a
  Eq u 1 level+ ^ M $
    MyMonoid.mul u ^ M $ inst $ a $  MyMonoid.one u ^ M $ inst $  $  $  a $
:=
  MyMonoid.mul_one u ^ M $ inst $ a $
end mul_one'
end MyMonoid
