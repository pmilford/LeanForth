kernel-form \ A name with a numeric part (Lean's Name.num): Lean names a private
\ declaration _private.MODULE.0.NAME, MODULE the file's module (here the
\ Lean source's path as check_author.py compiles it, from the repository
\ root), 0 a numeric part. The text declares it by its
\ full name and uses it; the export must write the numeric part as it is
\ (check_author.py, records).
\ Lean: private theorem twice (p : Prop) (h : p) : p := h
\       theorem useTwice (p : Prop) (h : p) : p := twice p h
theorem _private.tests.reference.author-21-numeric-name.0.twice
  Prop explicit: p
  p explicit: h
  p
:=
  h
end _private.tests.reference.author-21-numeric-name.0.twice

theorem useTwice
  Prop explicit: p
  p explicit: h
  p
:=
  _private.tests.reference.author-21-numeric-name.0.twice  p $  h $
end useTwice
