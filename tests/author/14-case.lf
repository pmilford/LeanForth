kernel-form \ Names that differ only in case, which Forth's own lookup cannot tell
\ apart on Gforth: a variable x of type X, the constants id and Id, and a
\ variable named prop (Forth finds the word Prop for it first).
\ Lean: def caseVar {X : Type} (x : X) : X := x
\       def bothIds (f : Id Nat) : Id Nat := id f
\       def propVar (prop : Prop) : Prop := prop
\ Nat, id and Id are Init's (plan task 8.2.1d):
\   leanforth check --env tests/author/init-slice.ndjson tests/author/14-case.lf
def caseVar
  0 Type implicit: X
  X explicit: x
  X
:=
  x
end caseVar

def bothIds
  Id 0 ^ Nat $  explicit: f
  Id 0 ^ Nat $
:=
  id 1 ^  Id 0 ^ Nat $  $  f $
end bothIds

def propVar
  Prop explicit: prop
  Prop
:=
  prop
end propVar
