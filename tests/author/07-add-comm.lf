kernel-form \ Lean: theorem add_comm' (n m : Nat) : n + m = m + n := Nat.add_comm n m
\ Nat, Eq, HAdd.hAdd, instHAdd, instAddNat and Nat.add_comm are Lean's own,
\ from its core library Init: the text names them as Lean does and is
\ checked against an export of Init (plan task 8.2.1d):
\   leanforth check --env tests/author/init-slice.ndjson tests/author/07-add-comm.lf
theorem add_comm'
  Nat explicit: n
  Nat explicit: m
  Eq 1 ^ Nat $
    HAdd.hAdd 0 ^ 0 ^ 0 ^ Nat $ Nat $ Nat $  instHAdd 0 ^ Nat $ instAddNat $  $  n $ m $
  $
    HAdd.hAdd 0 ^ 0 ^ 0 ^ Nat $ Nat $ Nat $  instHAdd 0 ^ Nat $ instAddNat $  $  m $ n $
  $
:=
  Nat.add_comm n $ m $
end add_comm'
