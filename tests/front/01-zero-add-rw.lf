\ FE1g's main test in natural LeanForth (docs/design/FE1G_TACTICS.md 3.1).
\ Lean: theorem zero_add'' (n : Nat) : 0 + n = n := by
\         induction n with
\         | zero => rfl
\         | succ k ih => rw [Nat.add_succ, ih]
\ With the S2 slice and its elaboration data it is accepted, its term pinned
\ Lean's (tests/front/check_s2.py); with tests/front/tactic-slice.ndjson
\ alone (no elaboration data) end stops, not supported yet (139, exit 2).
theorem zero_add''
  Nat explicit: n
  0 n + n =
:= by
  n by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ]
  by-end
end zero_add''
