\ FE1g's main test in natural LeanForth (docs/design/FE1G_TACTICS.md 3.1).
\ Lean: theorem zero_add'' (n : Nat) : 0 + n = n := by
\         induction n with
\         | zero => rfl
\         | succ k ih => rw [Nat.add_succ, ih]
\ Today (plan FE1g-2) the tactic proof is read whole and its shape is
\ checked; end stops as not supported yet (error 80, exit 2): running the
\ tactics is plan FE1g-3 onward. Constants: tests/front/tactic-slice.ndjson.
theorem zero_add''
  Nat explicit: n
  0 n + n =
:= by
  n by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ]
  by-end
end zero_add''
