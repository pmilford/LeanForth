\ A wrong twin: a brace with no goal left, Lean's No goals to be solved
\ (90; plan row TB2, blocks slice 1; blocks-1-wrong.lean).
\ Lean: theorem w_brace_none (a b : Nat) (h : a = b) : a = b := by
\         exact h
\         { exact h }
theorem w_brace_none
  Nat explicit: a  Nat explicit: b
  a b = explicit: h
  a b =
:= by
  ' h by-exact
  { ' h by-exact }
end w_brace_none
