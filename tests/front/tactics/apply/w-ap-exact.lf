\ A wrong twin of ap-exact.lf (plan 9.4.8l J; tests/front/tactics/
\ goal-layer-wrong.lean): after apply h1 assigns m, h1 is no proof of
\ ?m ≤ c, and exact fails with Lean's Type mismatch (error 96), the
\ expected type printed instantiated.
\ Lean: theorem w_ap_exact (a b c : Nat) (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c := by
\         apply Nat.le_trans
\         apply h1
\         exact h1
theorem w_ap_exact
  Nat explicit: a  Nat explicit: b  Nat explicit: c
  a b ≤ explicit: h1  b c ≤ explicit: h2
  a c ≤
:= by
  ' Nat.le_trans by-apply
  ' h1 by-apply
  ' h1 by-exact
end w_ap_exact
