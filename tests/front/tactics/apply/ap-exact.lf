\ by-exact on the goals by-apply leaves (plan 9.4.8l J; tests/front/
\ tactics/goal-layer.lean): h1 against a ≤ ?m, which assigns m, then h2
\ against ?m ≤ ?k with both assigned, as Lean's exact elaborates against
\ the goal's type as stored (whnf's reduceNat? instantiates them: Nat.le
\ b c folds nothing). The term is @Nat.le_trans a b c h1 h2.
\ Lean: theorem ap_exact (a b c : Nat) (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c := by
\         apply Nat.le_trans
\         exact h1
\         exact h2
theorem ap_exact
  Nat explicit: a  Nat explicit: b  Nat explicit: c
  a b ≤ explicit: h1  b c ≤ explicit: h2
  a c ≤
:= by
  ' Nat.le_trans by-apply
  ' h1 by-exact
  ' h2 by-exact
end ap_exact
