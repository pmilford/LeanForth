\ by-exfalso, then by-exact (plan row TB1; tests/front/tactics/
\ goal-layer.lean): the goal a = b becomes False, which h closes. The term
\ is @False.elim.{0} (a = b) h.
\ Lean: theorem ex_exact (a b : Nat) (h : False) : a = b := by
\         exfalso
\         exact h
theorem ex_exact
  Nat explicit: a  Nat explicit: b
  False explicit: h
  a b =
:= by
  by-exfalso
  ' h by-exact
end ex_exact
