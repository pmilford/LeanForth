theorem as_leap
  2024 4 % 0 =  2024 100 % 0 Ne  /\
:= by
  by-decide
end as_leap

theorem as_not
  2 2 + 5 = Not
:= by
  by-decide
end as_not

theorem as_or
  10 20 <  20 10 <  \/
:= by
  by-decide
end as_or

theorem as_iff
  2 2 + 4 =  3 3 <=  <->
:= by
