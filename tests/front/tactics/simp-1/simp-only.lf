\ by-simp-only[ ] on the target (plan row FE9, simp slice SL1a-1 of
\ docs/design/TACTIC_SIMP.md): Lean's simp only. Lean twins in simp-1.lean.
\ Lean: theorem simp_add_zero (n : Nat) : n + 0 + 0 = n := by
\         simp only [Nat.add_zero]
\ Nat.add_zero is an rfl theorem: no step, then eq_self closes n = n.
theorem simp_add_zero
  Nat explicit: n
  n 0 + 0 + n =
:= by
  by-simp-only[ ' Nat.add_zero ]
end simp_add_zero

\ Lean: theorem simp_hyp (a b : Nat) (h : a = b) : a * 2 = b * 2 := by
\         simp only [h]
\ A hypothesis rule (origin .stx, head-only keys) under two congruences.
theorem simp_hyp
  Nat explicit: a  Nat explicit: b
  a b = explicit: h
  a 2 * b 2 * =
:= by
  by-simp-only[ ' h ]
end simp_hyp

\ Lean: theorem simp_hyp_whole (a c : Nat) (h : a * 6 = c) : a * 6 = c := by
\         simp only [h]
theorem simp_hyp_whole
  Nat explicit: a  Nat explicit: c
  a 6 * c = explicit: h
  a 6 * c =
:= by
  by-simp-only[ ' h ]
end simp_hyp_whole

\ Lean: theorem simp_true : True := by simp only []
\ True is closed by True.intro, with no "no progress".
theorem simp_true
  True
:= by
  by-simp-only[ ]
end simp_true

\ Lean: theorem simp_self (n : Nat) : n = n := by simp only []
theorem simp_self
  Nat explicit: n
  n n =
:= by
  by-simp-only[ ]
end simp_self

\ Lean: theorem simp_symm (a b : Nat) (h : b = a) : a = b := by
\         simp only [← h]
\ h right to left: the rule is Eq.symm h, a = b, at a.
theorem simp_symm
  Nat explicit: a  Nat explicit: b
  b a = explicit: h
  a b =
:= by
  by-simp-only[ ' h <- ]
end simp_symm

\ Lean: theorem simp_prop (a b : Nat) (h : a ≤ b) : a ≤ b ∧ a ≤ b := by
\         simp only [h, and_self]
\ h, no equation, is the rule eq_true h : (a ≤ b) = True; then and_self.
theorem simp_prop
  Nat explicit: a  Nat explicit: b
  a b ≤ explicit: h
  a b ≤ a b ≤ ∧
:= by
  by-simp-only[ ' h ' and_self ]
end simp_prop

\ Lean: theorem simp_same_head (a b : Nat) (h : a + 1 = b + 1) :
\           a + 1 + 1 = b + 1 + 1 := by simp only [h]
\ h's sides share their head, but a and b differ: no perm theorem.
theorem simp_same_head
  Nat explicit: a  Nat explicit: b
  a 1 + b 1 + = explicit: h
  a 1 + 1 + b 1 + 1 + =
:= by
  by-simp-only[ ' h ]
end simp_same_head
\ Lean: theorem simp_mul_zero (n : Nat) : n * 0 = 0 := by
\         simp only [Nat.mul_zero]
\ The theorem's pattern ?n * 0 is unified with n * 0 pattern first, as
\ Lean's tryTheoremCore does (review M1 of 2026-11-25: evalNat's
\ operands, src/front/nat-offset.fs).
theorem simp_mul_zero
  Nat explicit: n
  n 0 * 0 =
:= by
  by-simp-only[ ' Nat.mul_zero ]
end simp_mul_zero
\ Lean: theorem simp_mul_one (n : Nat) : n * 1 = n := by
\         simp only [Nat.mul_one]
theorem simp_mul_one
  Nat explicit: n
  n 1 * n =
:= by
  by-simp-only[ ' Nat.mul_one ]
end simp_mul_one
\ Lean: theorem simp_mul_one_twice (a : Nat) : a * 1 * 1 = a := by
\         simp only [Nat.mul_one]
theorem simp_mul_one_twice
  Nat explicit: a
  a 1 * 1 * a =
:= by
  by-simp-only[ ' Nat.mul_one ]
end simp_mul_one_twice
\ Lean: theorem simp_zero_add_mul_one (n : Nat) : 0 + n = n * 1 := by
\         simp only [Nat.zero_add, Nat.mul_one]
theorem simp_zero_add_mul_one
  Nat explicit: n
  0 n + n 1 * =
:= by
  by-simp-only[ ' Nat.zero_add ' Nat.mul_one ]
end simp_zero_add_mul_one
\ Lean: theorem simp_sub_self (a : Nat) : (a + 1) - (a + 1) = 0 := by
\         simp only [Nat.sub_self]
\ The pattern ?n - ?n: its variable met twice.
theorem simp_sub_self
  Nat explicit: a
  a 1 + a 1 + - 0 =
:= by
  by-simp-only[ ' Nat.sub_self ]
end simp_sub_self
\ Lean: theorem simp_chain (a b c : Nat) (h : a = b) (h2 : b = c) : a = c := by
\         simp only [h, h2]
\ h's result b is simplified again (visitPostContinue): h2 makes it c
\ (review M2 of 2026-11-25).
theorem simp_chain
  Nat explicit: a  Nat explicit: b  Nat explicit: c
  a b = explicit: h  b c = explicit: h2
  a c =
:= by
  by-simp-only[ ' h ' h2 ]
end simp_chain
\ Lean: theorem simp_one_mul (n : Nat) : 1 * n = n := by
\         simp only [Nat.one_mul]
theorem simp_one_mul
  Nat explicit: n
  1 n * n =
:= by
  by-simp-only[ ' Nat.one_mul ]
end simp_one_mul
