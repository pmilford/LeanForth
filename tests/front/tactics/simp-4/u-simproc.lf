\ Lean: theorem u_simproc (a : Nat) : (a = 0 ∧ True) ↔ a = 0 := by simp
\ Not supported yet (99): no lemma rewrites a = 0, and reduceCtorEq and
\ Nat.reduceEqDiff, keyed on it, are not ported (simp group 4, pass 2).
theorem u_simproc
  Nat explicit: a  a 0 = True ∧ a 0 = ↔
:= by
  by-simp
end u_simproc
