\ Lean: theorem u_binder_arrow (a b c : Nat) (h2 : a = c) (h : a = b) : c = b := by
\         revert h
\         simp only [h2]
\         intro h
\         exact h
\ Not supported yet (99): the target a = b -> c = b is an arrow, which
\ Lean's simpArrow simplifies on both sides (implies_congr); LeanForth's
\ simp does not go below a binder yet (slice SL1b's binders).
theorem u_binder_arrow
  Nat explicit: a  Nat explicit: b  Nat explicit: c
  a c = explicit: h2  a b = explicit: h
  c b =
:= by
  ' h by-revert
  by-simp-only[ ' h2 ]
  by-intro: h
  ' h by-exact
end u_binder_arrow
