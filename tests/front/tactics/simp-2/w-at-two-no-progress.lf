\ Lean: theorem w_at_two_no_progress (a b : Nat) (h : a = b) (k : b = a) : a = b := by
\         simp only [Nat.add_zero] at h k
\ Neither location changes: the error once, for both.
theorem w_at_two_no_progress
  Nat explicit: a  Nat explicit: b
  a b = explicit: h  b a = explicit: k
  a b =
:= by
  by-simp-only[ ' Nat.add_zero ] at[ h k ]
end w_at_two_no_progress
