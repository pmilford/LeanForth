\ Lean: theorem u_binder_forall (a : Nat) : a + 0 = a := by
\         revert a
\         simp only [Nat.add_zero]
\         intro a
\         exact True.intro
\ Not supported yet (99): the target ∀ a, a + 0 = a, which Lean's
\ simpForall simplifies under the binder to ∀ a, True (forall_congr).
theorem u_binder_forall
  Nat explicit: a
  a 0 + a =
:= by
  ' a by-revert
  by-simp-only[ ' Nat.add_zero ]
  by-intro: a
  ' True.intro by-exact
end u_binder_forall
