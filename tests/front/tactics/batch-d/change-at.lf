\ T by-change at: and by-symm at: (plan row TB2, tactic batch 3a;
\ batch-d.lean): Lean's change T at h (changeLocalDecl: the hypothesis
\ reverted, its type replaced, introduced again under its name) and symm
\ at h (applySymmAt: the hypothesis replaced by its symmetric form), then
\ the new hypothesis used by name.
\ Lean: theorem ch_at (a b : Nat) (h : a + 0 = b) : a = b := by
\         change a = b at h
\         exact h
theorem ch_at
  Nat explicit: a  Nat explicit: b
  a 0 + b = explicit: h
  a b =
:= by
  a b = by-change at: h
  ' h by-exact
end ch_at

\ A hypothesis and the goal.
\ Lean: theorem ch_goal (a b : Nat) (h : a + 0 = b) : a + 0 = b := by
\         change a = b at h ⊢
\         exact h
theorem ch_goal
  Nat explicit: a  Nat explicit: b
  a 0 + b = explicit: h
  a 0 + b =
:= by
  a b = by-change at: h |-
  ' h by-exact
end ch_goal

\ Lean: theorem sy_at (a b : Nat) (h : a = b) (h2 : b = a) : a = b := by
\         symm at h2
\         exact h2
theorem sy_at
  Nat explicit: a  Nat explicit: b
  a b = explicit: h  b a = explicit: h2
  a b =
:= by
  by-symm at: h2
  ' h2 by-exact
end sy_at

\ Ne's lemma, a hypothesis and the goal.
\ Lean: theorem sy_at_ne (a b : Nat) (h : a ≠ b) : a ≠ b := by
\         symm at h ⊢
\         assumption
theorem sy_at_ne
  Nat explicit: a  Nat explicit: b
  a b ≠ explicit: h
  a b ≠
:= by
  by-symm at: h |-
  by-assumption
end sy_at_ne

\ by-rfl on an Iff: exact Iff.rfl, the macro's newest rule; rw's rfl
\ closes q ↔ q too.
\ Lean: theorem rf_iff (a b : Nat) : a ≤ b ↔ a ≤ b := by
\         rfl
theorem rf_iff
  Nat explicit: a  Nat explicit: b
  a b ≤ a b ≤ ↔
:= by
  by-rfl
end rf_iff

\ Lean: theorem rf_rw_iff (a b : Nat) (h : a = b) : a ≤ b ↔ b ≤ b := by
\         rw [h]
theorem rf_rw_iff
  Nat explicit: a  Nat explicit: b
  a b = explicit: h
  a b ≤ b b ≤ ↔
:= by
  by-rw[ ' h ]
end rf_rw_iff

\ by-rfl on a goal that unfolds to an equation or an Iff (id is unfolded
\ at default transparency, as Lean's rules do: review tb2-batch3a).
\ Lean: theorem rf_id (a : Nat) : id (a = a) := by
\         rfl
theorem rf_id
  Nat explicit: a
  a a = id
:= by
  by-rfl
end rf_id

\ Lean: theorem rf_id_iff (a b : Nat) : id (a ≤ b ↔ a ≤ b) := by
\         rfl
theorem rf_id_iff
  Nat explicit: a  Nat explicit: b
  a b ≤ a b ≤ ↔ id
:= by
  by-rfl
end rf_id_iff

\ Three steps over two hypotheses, the worked example of
\ docs/user/LANGUAGE_REFERENCE.md's tactic batches: symm at h, then rw
\ with the new h at h2, then the new h2.
\ Lean: theorem sy_rw_at (a b c : Nat) (h : a = b) (h2 : b ≤ c) : a ≤ c := by
\         symm at h
\         rw [h] at h2
\         exact h2
theorem sy_rw_at
  Nat explicit: a  Nat explicit: b  Nat explicit: c
  a b = explicit: h  b c ≤ explicit: h2
  a c ≤
:= by
  by-symm at: h
  by-rw[ ' h ] at: h2
  ' h2 by-exact
end sy_rw_at
