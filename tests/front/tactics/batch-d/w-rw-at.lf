\ Lean: theorem w_rw_at (a b c d : Nat) (h : a = b) (h2 : c ≤ d) : c ≤ d := by
\         rw [h] at h2
theorem w_rw_at
  Nat explicit: a  Nat explicit: b  Nat explicit: c  Nat explicit: d
  a b = explicit: h  c d ≤ explicit: h2
  c d ≤
:= by
  by-rw[ ' h ] at: h2
end w_rw_at
