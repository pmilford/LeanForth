\ A wrong twin (plan row TB2; batch-a-wrong.lean): a ≤ b is not
\ definitionally equal to a ≥ b (that is b ≤ a), error 443.
\ Lean: theorem w_ch (a b : Nat) (h : b ≤ a) : a ≥ b := by
\         change a ≤ b
\         exact h
theorem w_ch
  Nat explicit: a  Nat explicit: b
  b a ≤ explicit: h
  a b ≥
:= by
  a b ≤ by-change
  ' h by-exact
end w_ch
