\ A wrong twin (plan row TB2; batch-a-wrong.lean): after specialize h the
\ goal is still a ≤ b, which h2 : b ≤ a (reverted and introduced again,
\ the new h2 the name means) does not prove: exact's Type mismatch, 96.
\ Lean: theorem w_sp_exact (a b : Nat) (h : a ≤ b) (h2 : b ≤ a) : a ≤ b := by
\         specialize h
\         exact h2
theorem w_sp_exact
  Nat explicit: a  Nat explicit: b
  a b ≤ explicit: h  b a ≤ explicit: h2
  a b ≤
:= by
  ' h by-specialize
  ' h2 by-exact
end w_sp_exact
