\ A wrong proof for S2's tactics (tests/front/check_s2.py; its Lean twin is
\ tests/front/s2-wrong.lean's w_case_suffix): foo.zero is no suffix of
\ succ.zero (Name.isSuffixOf compares every component): refused with Lean's
\ first message.
theorem w_case_suffix
  Nat explicit: n  Nat explicit: m
  0 n + n =
:= by
  n by-induction-with
  | zero =>       by-rfl
  | succ k ih =>
    m by-induction
    by-case: foo.zero =>     by-rw[ ' Nat.add_succ ih ]  by-end
    by-case: succ j ih2 =>   ih2 by-exact                by-end
  by-end
end w_case_suffix
