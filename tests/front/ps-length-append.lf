\ The owner's proof set (docs/design/S2_INTERFACE.md appendix G):
\ |xs ++ ys| = |xs| + |ys|, with the set's earlier theorems it rewrites by.
\ Lean: tests/front/s2-proofs.lean's ps_zero_add, ps_succ_add and
\       theorem ps_length_append (xs ys : List Nat) :
\           (xs ++ ys).length = xs.length + ys.length := by
\         induction xs with
\         | nil => rw [List.nil_append, List.length_nil, ps_zero_add]
\         | cons x t ih => rw [List.cons_append, List.length_cons, List.length_cons, ih, ps_succ_add]
\ LeanForth has no ++ word yet: xs ys HAppend.hAppend is Lean's
\ binop% HAppend.hAppend xs ys with both sides of one type.
theorem ps_zero_add
  Nat explicit: n
  0 n + n =
:= by
  n by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ]
  by-end
end ps_zero_add
theorem ps_succ_add
  Nat explicit: n  Nat explicit: m
  n Nat.succ m + n m + Nat.succ =
:= by
  m by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ' Nat.add_succ ]
  by-end
end ps_succ_add
theorem ps_length_append
  Nat List explicit: xs  Nat List explicit: ys
  xs ys HAppend.hAppend List.length  xs List.length ys List.length + =
:= by
  xs by-induction-with
  | nil =>           by-rw[ ' List.nil_append ' List.length_nil ' ps_zero_add ]
  | cons x t ih =>   by-rw[ ' List.cons_append ' List.length_cons ' List.length_cons ih ' ps_succ_add ]
  by-end
end ps_length_append
