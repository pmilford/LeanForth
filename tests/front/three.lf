\ Three natural declarations, an axiom, a definition and a theorem (plan
\ row FE1f; tests/front/handover.fs runs it with a stand-in elaborator, as
\ FE1e's elaborator does not elaborate numerals yet; run alone it stops
\ at the end of two, whose 2 waits for plans FE1e5 and S2, with error 139).
\ Lean: axiom someNat : Nat
\       def two : Nat := 2
\       theorem add_zero' (n : Nat) : n + 0 = n := Eq.refl n
axiom someNat
  Nat
end someNat

def two
  Nat
:=
  2
end two

theorem add_zero'
  Nat explicit: n
  n 0 + n =
:=
  n Eq.refl
end add_zero'
