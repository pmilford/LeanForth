      theorem zero_add_nested
        Nat explicit: n  Nat explicit: m
        0 n + n =
      := by
        n by-induction-with
        | zero =>       by-rfl
        | succ k ih =>
          m by-induction-with
          | zero =>       by-rw[ ' Nat.add_succ ih ]
          | succ j ih =>  ih by-exact
          by-end
        by-end
      end zero_add_nested

