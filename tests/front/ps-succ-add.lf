\ The owner's proof set (docs/design/S2_INTERFACE.md appendix G): (n + 1) + m = (n + m) + 1.
\ Lean: theorem ps_succ_add (n m : Nat) : Nat.succ n + m = Nat.succ (n + m) := by
\         induction m with
\         | zero => rfl
\         | succ k ih => rw [Nat.add_succ, ih, Nat.add_succ]
theorem ps_succ_add
  Nat explicit: n  Nat explicit: m
  n Nat.succ m + n m + Nat.succ =
:= by
  m by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ' Nat.add_succ ]
  by-end
end ps_succ_add
