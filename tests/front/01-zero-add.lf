\ Lean: theorem zero_add' (n : Nat) : 0 + n = n := by
\         induction n
\         case zero => rfl
\         case succ k ih => exact congrArg Nat.succ ih
\ Today the tactic proof is read whole and its shape checked (FE1g-2); end
\ stops, not supported yet (error 139, exit 2): 0 and + wait for plans
