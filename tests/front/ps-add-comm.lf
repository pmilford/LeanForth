\ The owner's proof set (docs/design/S2_INTERFACE.md appendix G): n + m = m + n,
\ with the set's earlier theorems it rewrites by.
\ Lean: tests/front/s2-proofs.lean's ps_zero_add, ps_succ_add and
\       theorem ps_add_comm (n m : Nat) : n + m = m + n := by
\         induction m with
\         | zero => rw [ps_zero_add]; rfl
\         | succ k ih => rw [Nat.add_succ, ih, ps_succ_add]
theorem ps_zero_add
  Nat explicit: n
  0 n + n =
:= by
  n by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ]
  by-end
end ps_zero_add
theorem ps_succ_add
  Nat explicit: n  Nat explicit: m
  n Nat.succ m + n m + Nat.succ =
:= by
  m by-induction-with
  | zero =>       by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ' Nat.add_succ ]
  by-end
end ps_succ_add
theorem ps_add_comm
  Nat explicit: n  Nat explicit: m
  n m + m n + =
:= by
  m by-induction-with
  | zero =>       by-rw[ ' ps_zero_add ] by-rfl
  | succ k ih =>  by-rw[ ' Nat.add_succ ih ' ps_succ_add ]
  by-end
end ps_add_comm
