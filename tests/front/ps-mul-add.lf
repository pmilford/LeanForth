\ The owner's proof set (docs/design/S2_INTERFACE.md appendix G):
\ n + (m + k) = (n + m) + k and n * (m + k) = n * m + n * k.
\ Lean: tests/front/s2-proofs.lean's ps_add_assoc and ps_mul_add, as
\ appendix G writes them (the zero cases by rfl: Nat.add's and Nat.mul's
\ smart unfolding, S2 merge B; a match stuck on a variable unfolds nothing).
theorem ps_add_assoc
  Nat explicit: n  Nat explicit: m  Nat explicit: k
  n m k + + n m + k + =
:= by
  k by-induction-with
  | zero =>       by-rfl
  | succ j ih =>  by-rw[ ' Nat.add_succ ' Nat.add_succ ih ' Nat.add_succ ]
  by-end
end ps_add_assoc
theorem ps_mul_add
  Nat explicit: n  Nat explicit: m  Nat explicit: k
  n m k + * n m * n k * + =
:= by
  k by-induction-with
  | zero =>       by-rfl
  | succ j ih =>  by-rw[ ' Nat.add_succ ' Nat.mul_succ ih ' Nat.mul_succ ' ps_add_assoc ]
  by-end
end ps_mul_add
