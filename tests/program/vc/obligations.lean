/-- The postcondition: each case's guard implies its output and its ensures (the contract's statement is not copied here). -/
def post (c : Cells) (value lower upper : Int) (out : List Int) : Prop :=
  (lower > upper → out = [0]) ∧
    (lower ≤ upper → ∃ r : Int, out = [(-1), r] ∧ (r = (min (max value lower) upper)) ∧ ((lower ≤ r) ∧ (r ≤ upper)) ∧ (((lower ≤ value) ∧ (value ≤ upper)) → (r = value)) ∧ ((value < lower) → (r = lower)) ∧ ((value > upper) → (r = upper)))

theorem O1 (c : Cells) (value lower upper : Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper)
    (p1 : lower > upper)
    : post c value lower upper [0] := by
  have := c.min_eq
  have := c.max_pos
  have := c.two_le
  simp only [post]
  refine ⟨?_, ?_⟩
  · intro g
    first | rfl | trivial
  · intro g
    exfalso
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega

theorem O2 (c : Cells) (value lower upper : Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper)
    (p1 : ¬(lower > upper))
    : post c value lower upper [(-1), min (max value lower) upper] := by
  have := c.min_eq
  have := c.max_pos
  have := c.two_le
  simp only [post]
  refine ⟨?_, ?_⟩
  · intro g
    exfalso
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega
  · intro g
    refine ⟨_, rfl, ?_⟩
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega

/-- The contract, on the IR semantics: for every cell width, input and stack below. -/
theorem contract (c : Cells) (fuel : Nat) (value lower upper : Int) (tail rs : List Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper) :
    ∃ out, callWord c program (fuel + 1) "lf-clamp"
      ⟨upper :: lower :: value :: tail, rs⟩ = .next ⟨out ++ tail, rs⟩ ∧
      post c value lower upper out := by
  by_cases h1 : lower > upper
  · refine ⟨[0], ?_, O1 c value lower upper f1 f2 f3 h1⟩
    vc_run program
  · refine ⟨[(-1), min (max value lower) upper], ?_, O2 c value lower upper f1 f2 f3 h1⟩
    vc_run program

#print axioms O1
#print axioms O2
#print axioms contract

end LfClamp0

