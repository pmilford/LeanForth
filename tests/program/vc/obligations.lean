def program : Program := [
  ("lf-example-max", .constant [.lit (-1), .lit 1, .prim .rshift]),
  ("lf-example-min", .constant [.call "lf-example-max", .prim .invert]),
  ("lf-add-above?", .word [.call "lf-example-max", .prim .swap, .prim .sub, .prim .gt]),
  ("lf-add-below?", .word [.call "lf-example-min", .prim .swap, .prim .sub, .prim .lt]),
  ("lf-add-overflow?", .word [.prim .dup, .prim .zeroGt, .ifElse [.call "lf-add-above?", .exit] [], .prim .dup, .prim .zeroLt, .ifElse [.call "lf-add-below?"] [.prim .twoDrop, .prim .false]]),
  ("lf-checked-add", .word [.prim .twoDup, .call "lf-add-overflow?", .ifElse [.prim .twoDrop, .prim .false] [.prim .add, .prim .true]]),
  ("lf-checked-abs", .word [.prim .dup, .call "lf-example-min", .prim .eq, .ifElse [.prim .drop, .prim .false] [.prim .abs, .prim .true]]),
  ("lf-product-over?", .word [.call "lf-example-max", .prim .swap, .prim .div, .prim .gt]),
  ("lf-factorial-from", .word [.loop [.prim .dup, .lit 1, .prim .gt] [.prim .twoDup, .call "lf-product-over?", .ifElse [.prim .twoDrop, .prim .false, .exit] [], .prim .tuck, .prim .mul, .prim .swap, .prim .oneMinus], .prim .drop, .prim .true]),
  ("lf-factorial", .word [.prim .dup, .prim .zeroLt, .ifElse [.prim .drop, .prim .false] [.lit 1, .prim .swap, .call "lf-factorial-from"]]),
  ("lf-euclid", .word [.loop [.prim .dup, .prim .zeroNe] [.prim .tuck, .prim .mod], .prim .drop]),
  ("lf-gcd", .word [.prim .twoDup, .prim .zeroLt, .prim .swap, .prim .zeroLt, .prim .or, .ifElse [.prim .twoDrop, .prim .false] [.call "lf-euclid", .prim .true]]),
  ("lf-within-closed?", .word [.prim .toR, .prim .over, .prim .gt, .prim .zeroEq, .prim .swap, .prim .fromR, .prim .gt, .prim .zeroEq, .prim .and]),
  ("lf-in-range", .word [.prim .twoDup, .prim .gt, .ifElse [.prim .twoDrop, .prim .drop, .prim .false] [.call "lf-within-closed?", .prim .true]])]

-- The program printed back in the IR text form, for comparison with the IR.
#eval IO.print ("vc-program LfInRange0\n" ++ render "src/program/examples.fs" program ++ "vc-program-end\n")

/-- The postcondition: each case's guard implies its output and its ensures (the contract's statement is not copied here). -/
def post (c : Cells) (value lower upper : Int) (out : List Int) : Prop :=
  (lower > upper → out = [0]) ∧
    (lower ≤ upper → ∃ f : Int, out = [(-1), f] ∧ (f = (flag (decide ((lower ≤ value) ∧ (value ≤ upper))))))

theorem O1 (c : Cells) (value lower upper : Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper)
    (p1 : lower > upper)
    : post c value lower upper [0] := by
  have := c.min_eq
  have := c.max_pos
  have := c.two_le
  simp only [post]
  refine ⟨?_, ?_⟩
  · intro g
    first | rfl | trivial
  · intro g
    exfalso
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega

theorem O2 (c : Cells) (value lower upper : Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper)
    (p1 : ¬(lower > upper))
    : post c value lower upper [(-1), flag (decide ((¬(lower > value)) ∧ (¬(value > upper))))] := by
  have := c.min_eq
  have := c.max_pos
  have := c.two_le
  simp only [post]
  refine ⟨?_, ?_⟩
  · intro g
    exfalso
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega
  · intro g
    refine ⟨_, rfl, ?_⟩
    try simp only [Cells.Fits, flag, decide_eq_true_eq, List.cons.injEq, and_true, true_and] at *
    all_goals omega

/-- The contract, on the IR semantics: for every cell width, input and stack below. -/
theorem contract (c : Cells) (fuel : Nat) (value lower upper : Int) (tail rs : List Int)
    (f1 : c.Fits value)
    (f2 : c.Fits lower)
    (f3 : c.Fits upper) :
    ∃ out, callWord c program (fuel + 2) "lf-in-range"
      ⟨upper :: lower :: value :: tail, rs⟩ = .next ⟨out ++ tail, rs⟩ ∧
      post c value lower upper out := by
  by_cases h1 : lower > upper
  · refine ⟨[0], ?_, O1 c value lower upper f1 f2 f3 h1⟩
    vc_run program
  · refine ⟨[(-1), flag (decide ((¬(lower > value)) ∧ (¬(value > upper))))], ?_, O2 c value lower upper f1 f2 f3 h1⟩
    vc_run program

#print axioms O1
#print axioms O2
#print axioms contract

end LfInRange0

/-! Contract lf-clamp/wrong-swapped for `lf-clamp`, from tests/program/contracts/wrong-clamp-swapped.contract. -/
namespace LfClampWrongSwapped

def program : Program := [
  ("lf-clamp", .word [.prim .twoDup, .prim .gt, .ifElse [.prim .twoDrop, .prim .drop, .prim .false, .exit] [], .prim .toR, .prim .max, .prim .fromR, .prim .min, .prim .true])]

-- The program printed back in the IR text form, for comparison with the IR.
#eval IO.print ("vc-program LfClampWrongSwapped\n" ++ render "src/program/clamp.fs" program ++ "vc-program-end\n")

/-- The postcondition: each case's guard implies its output and its ensures (the contract's statement is not copied here). -/
def post (c : Cells) (value lower upper : Int) (out : List Int) : Prop :=
  (lower > upper → out = [0]) ∧
    (lower ≤ upper → ∃ r : Int, out = [(-1), r] ∧ (r = (max (min value lower) upper)))

/-- The contract is false: on 64-bit cells, with value = -3, lower = -3, upper = -2,
the postcondition fails. -/
theorem refuted : ¬ ∀ (c : Cells) (fuel : Nat) (value lower upper : Int) (tail rs : List Int),
    c.Fits value → c.Fits lower → c.Fits upper →
    ∃ out, callWord c program (fuel + 1) "lf-clamp"
      ⟨upper :: lower :: value :: tail, rs⟩ = .next ⟨out ++ tail, rs⟩ ∧
      post c value lower upper out := by
  intro h
  obtain ⟨out, hrun, hpost⟩ := h cells64 0 (-3) (-3) (-2) [] [] (by vc_fits) (by vc_fits) (by vc_fits)
  vc_eval program at hrun
  first
  | (subst hrun; simp only [post] at hpost; simp at hpost; try omega)
  | skip

#print axioms refuted

end LfClampWrongSwapped

