-- BEGIN VERBATIM tests/reference/program-ir.lean 1253-1319
def Prim.word : Prim → String
  | .dup => "dup" | .drop => "drop" | .swap => "swap" | .over => "over" | .nip => "nip"
  | .tuck => "tuck" | .rot => "rot" | .twoDup => "2dup" | .twoDrop => "2drop"
  | .toR => ">r" | .fromR => "r>" | .rFetch => "r@"
  | .add => "+" | .sub => "-" | .mul => "*" | .div => "/" | .mod => "mod"
  | .negate => "negate" | .abs => "abs" | .onePlus => "1+" | .oneMinus => "1-"
  | .eq => "=" | .ne => "<>" | .lt => "<" | .gt => ">"
  | .zeroEq => "0=" | .zeroNe => "0<>" | .zeroLt => "0<" | .zeroGt => "0>"
  | .and => "and" | .or => "or" | .xor => "xor" | .invert => "invert" | .rshift => "rshift"
  | .max => "max" | .min => "min" | .true => "true" | .false => "false"
  | .lshift => "lshift" | .negRot => "-rot"

/-- An output word as an `out` line writes it; a text between `." ` and `"`. -/
def Out.word : Out → String
  | .dot => "." | .uDot => "u." | .cr => "cr" | .emit => "emit" | .space => "space"
  | .spaces => "spaces" | .dotS => ".s" | .text s => ".\" " ++ s ++ "\""

/-- Whether an instruction is new in IR 0.2 (ADR 0019 Amendment 1, A4): an
`out` line, `prim lshift` or `prim -rot`, also inside IF and loops. -/
def Prim.new : Prim → Bool
  | .lshift | .negRot => Bool.true
  | _ => Bool.false

mutual
def Instr.new : Instr → Bool
  | .prim p => p.new
  | .out _ => true
  | .ifElse yes no => blockNew yes || blockNew no
  | .loop test body => blockNew test || blockNew body
  | _ => false

def blockNew : List Instr → Bool
  | [] => false
  | i :: rest => i.new || blockNew rest
end

/-- The lowest version that fits: IR 0.2 only when an instruction needs it. -/
def irVersion (p : Program) : String :=
  if p.any (fun d => match d.2 with | .word b | .constant b => blockNew b) then "0.2" else "0.1"

mutual
def renderInstr (pad : String) : Instr → List String
  | .prim p => [pad ++ "prim " ++ p.word]
  | .lit n => [pad ++ "lit " ++ toString n]
  | .call name => [pad ++ "call " ++ name]
  | .exit => [pad ++ "exit"]
  | .ifElse yes no =>
      [pad ++ "if"] ++ renderBlock (pad ++ "  ") yes ++
        (if no.isEmpty then [] else [pad ++ "else"] ++ renderBlock (pad ++ "  ") no) ++
        [pad ++ "then"]
  | .loop test body =>
      [pad ++ "begin"] ++ renderBlock (pad ++ "  ") test ++ [pad ++ "while"] ++
        renderBlock (pad ++ "  ") body ++ [pad ++ "repeat"]
  | .out o => [pad ++ "out " ++ o.word]

def renderBlock (pad : String) : List Instr → List String
  | [] => []
  | i :: rest => renderInstr pad i ++ renderBlock pad rest
end

def renderDef : String × Def → List String
  | (name, .word body) => ["word " ++ name] ++ renderBlock "  " body ++ ["end"]
  | (name, .constant body) => ["constant " ++ name] ++ renderBlock "  " body ++ ["end"]

def render (source : String) (p : Program) : String :=
  String.intercalate "\n" (["lf-ir " ++ irVersion p, "source " ++ source] ++
    p.flatMap renderDef) ++ "\n"
-- END VERBATIM

end ProgramIR

-- Part 2. The contracts.

-- Proofs are generated; their binders and simp sets are uniform, not minimal.
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
-- A name the generator did not bind is an error, never an implicit argument (review M2).
set_option autoImplicit false

namespace ProgramVC
open ProgramIR

theorem ir_max (a b : Int) : (if a < b then b else a) = max a b := by omega
theorem ir_min (a b : Int) : (if a < b then a else b) = min a b := by omega
theorem ir_cell_min (c : Cells) : -c.max - 1 = c.min := c.min_eq.symm
theorem ir_shift_one (c : Cells) : (1 : Int) < (c.bits : Int) := by have := c.two_le; omega
theorem ir_not_lt (a b : Int) : (!decide (a < b)) = decide (b ≤ a) := by
  by_cases h : a < b <;> simp [h] <;> omega

/-- The development host's cells, for counterexamples. -/
def cells64 : Cells := ⟨64, by decide⟩

/-- Run IR code on a path: unfold `callWord`, `run` and `step`, decide each
IF by the path's hypotheses, and name the IR's MAX, MIN and constants. -/
macro "vc_run" p:ident : tactic => `(tactic| (simp [callWord, run_call, run_prim, run_lit, run_exit,
  run_if, run_nil, step, lookup, $p:ident, flag_ne_zero, flag_beq_zero, and_flags, or_flags,
  decide_eq_true_eq, ir_max, ir_min, ir_cell_min, ir_shift_one, ir_not_lt,
  Cells.rshift_neg_one, Cells.fits_zero, Cells.fits_one, Cells.fits_neg_one, *]))

/-- Run IR code on concrete inputs on 64-bit cells. -/
macro "vc_eval" p:ident "at" h:ident : tactic => `(tactic| (simp [callWord, run_call, run_prim,
  run_lit, run_exit, run_if, run_nil, step, lookup, $p:ident, flag, bitwise, cells64,
  Cells.wrap, Cells.min, Cells.max, Cells.half, Cells.modulus, Cells.unsigned,
  Cells.signed, Cells.fits_zero, Cells.fits_one, Cells.fits_neg_one] at $h:ident))

/-- A concrete value fits in a 64-bit cell. -/
macro "vc_fits" : tactic => `(tactic| (simp [Cells.Fits, cells64, Cells.min, Cells.max,
  Cells.half]))

