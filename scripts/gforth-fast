#!/bin/bash
# gforth-fast, with the strict exit status of scripts/gforth-strict.sh.
#
# Test scripts that use "gforth-fast beside $GFORTH" (tests/core/compact-init.sh)
# find this file when the Makefile sets GFORTH to scripts/gforth-strict.sh.
# It runs the gforth-fast that sits beside the real Gforth ($LEANFORTH_GFORTH,
# else .tools/gforth/bin/gforth of this checkout, else gforth on PATH) through
# the strict wrapper; without one, the real Gforth itself.
here=$(cd "$(dirname "$0")" && pwd -P)
# Under make coverage (scripts/coverage.py) gforth-fast cannot load coverage.fs:
# the run goes to the counting wrapper, whose Gforth 1.0 is the checking engine.
if [ -n "${LF_COVERAGE_GFORTH:-}" ] && [ -n "${LF_COVERAGE_DIR:-}" ]; then
  exec "$here/coverage-gforth.sh" "$@"
fi
real=${LEANFORTH_GFORTH:-$here/../.tools/gforth/bin/gforth}
# A wrapper of scripts/ is never the real Gforth (see gforth-strict.sh).
case "$(readlink -f "$real" 2>/dev/null)" in
  "$here"/*) real=$here/../.tools/gforth/bin/gforth ;;
esac
[ -x "$real" ] || real=$(command -v "$real" || command -v gforth)
fast="$(dirname "$real")/gforth-fast"
if [ -x "$fast" ]; then real=$fast; fi
LEANFORTH_GFORTH=$real exec "$here/gforth-strict.sh" "$@"
