#!/usr/bin/env bash
# leanforth: LeanForth's command-line tool (plan tasks 3.4.1-3.4.2, v0).
# A small wrapper: it finds Gforth and runs the Forth entry point,
#   gforth src/main.fs -e cli-main COMMAND [OPTION]... [FILE]...
# (src/cli/leanforth.fs), with standard input closed, from any directory;
# file names are taken relative to the current directory.
# Usage: leanforth help; docs/user/COMMAND_LINE.md is the manual.
#
# The engine (owner, 2026-11-04): check, replay and print run on Gforth's
# checking engine, gforth, which stops at a stack or memory fault where it
# happens; with --fast they run on gforth-fast, about 2.4 times quicker
# with the same verdicts in every test. count and reexport, which check no
# proof, use gforth-fast (about 3.3 times faster on large exports,
# docs/development/NDJSON_READER.md). The engine is $GFORTH when set (with
# --fast, the gforth-fast in its folder when that exists), else the pinned one in
# .tools/gforth of this checkout (scripts/install-gforth.sh), else one on
# PATH. When --fast finds no gforth-fast, the run uses gforth and says so
# on standard error. The engine's file name is passed on in
# LEANFORTH_ENGINE, for the resource report and the JSON report.
# Exit status: 0 all accepted (or the command done), 1 something rejected,
# 2 unsupported or unknown, 3 a resource limit, 4 malformed input or
# command line, 5 an internal fault, 6 all accepted but some NOT PROVED
# (only with --strict-axioms). The Forth entry point leaves with 100
# plus that code; any other status from Gforth (its own failure, a crash,
# a signal) is an internal fault here, never a verdict.
# For version and the run record, the checkout's git commit is given when
# git can tell it (LEANFORTH_COMMIT, LEANFORTH_MODIFIED).
set -u

self=$0
command -v readlink >/dev/null 2>&1 && self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
root=$(cd "$(dirname "$self")/.." && pwd -P) || {
  printf 'leanforth: internal fault: cannot find the LeanForth checkout\n' >&2
  exit 5
}

# --fast among the options of check, replay or print (not the value of
# --record, --fuel, --name, --statement, --save-snapshot or --snapshot).
fast=false
case ${1:-} in
  check | replay | print)
    previous=
    for argument in "${@:2}"; do
      case $previous in
        --record | --fuel | --name | --statement | --save-snapshot | --snapshot) ;;
        *) if [ "$argument" = --fast ]; then fast=true; fi ;;
      esac
      previous=$argument
    done
    ;;
esac
engine=gforth
case ${1:-} in count | reexport) engine=gforth-fast ;; esac
if $fast; then engine=gforth-fast; fi
# The engine named, from this checkout's tools or the PATH.
find_engine() {
  if [ -x "$root/.tools/gforth/bin/$1" ]; then
    printf '%s' "$root/.tools/gforth/bin/$1"
  elif command -v "$1" >/dev/null 2>&1; then
    printf '%s' "$1"
  else
    return 1
  fi
}
no_fast() {
  printf 'leanforth: note: --fast: no %s found; checking with %s\n' "$1" "$2" >&2
}
# The fast engine beside GFORTH: the gforth-fast in its folder (for the
# Makefile's scripts/gforth-strict.sh, scripts/gforth-fast), or on PATH
# for a GFORTH without a folder; GFORTH itself when it is a gforth-fast.
beside_fast() {
  case ${GFORTH##*/} in
    gforth-fast*) printf '%s' "$GFORTH" ;;
    *) case $GFORTH in
         */*) printf '%s' "${GFORTH%/*}/gforth-fast" ;;
         *) printf '%s' gforth-fast ;;
       esac ;;
  esac
}
if [ -n "${GFORTH:-}" ]; then
  if $fast; then
    candidate=$(beside_fast)
    if command -v "$candidate" >/dev/null 2>&1; then
      GFORTH=$candidate
    else
      no_fast "$candidate" "$GFORTH"
    fi
  fi
elif GFORTH=$(find_engine "$engine"); then
  :
elif GFORTH=$(find_engine gforth); then
  if $fast; then no_fast gforth-fast "$GFORTH"; fi
else
  printf 'leanforth: internal fault: no Gforth found; %s\n' \
    'run scripts/install-gforth.sh or set GFORTH' >&2
  exit 5
fi
LEANFORTH_ENGINE=${GFORTH##*/}
export LEANFORTH_ENGINE

# reexport writes COPY, check --record RECORD and check --save-snapshot
# FILE: refuse one that
# names the export under another name before anything is written (the
# Forth side compares the names only as text).
if [ "${1:-}" = reexport ] || [ "${1:-}" = check ]; then
  files=() target= previous= what=
  for argument in "${@:2}"; do
    case $previous in
      --record) target=$argument ;;
      --save-snapshot) target=$argument what=FILE ;;
      --fuel | --snapshot) ;;
      *) case $argument in -*) ;; *) files+=("$argument") ;; esac ;;
    esac
    previous=$argument
  done
  what=${what:-RECORD}
  if [ "$1" = reexport ] && [ "${#files[@]}" -eq 2 ]; then target=${files[1]} what=COPY; fi
  if [ -n "$target" ] && [ "${#files[@]}" -ge 1 ] && [ -e "$target" ] &&
    [ "${files[0]}" -ef "$target" ]; then
    printf 'error: %s must not be EXPORT\n' "$what"
    exit 4
  fi
fi

# The checkout's git commit, and whether tracked files differ from it, for
# version and for the run record (check --record, replay); none outside a
# git checkout.
commit= modified=false
case ${1:-} in
  check | replay | version | --version)
    commit=$(git -C "$root" rev-parse HEAD 2>/dev/null) || commit=
    if [ -n "$commit" ] && ! git -C "$root" diff --quiet HEAD 2>/dev/null; then
      modified=true
    fi
    ;;
esac
export LEANFORTH_COMMIT=$commit LEANFORTH_MODIFIED=$modified

"$GFORTH" "$root/src/main.fs" -e cli-main "$@" </dev/null
status=$?
case $status in
  10[0-6]) code=$((status - 100)) ;;
  *)
    printf 'leanforth: internal fault: Gforth ended with status %s\n' "$status" >&2
    exit 5
    ;;
esac

if [ "$code" -eq 0 ] && { [ "${1:-}" = version ] || [ "${1:-}" = --version ]; }; then
  if [ -z "$commit" ]; then
    printf 'commit: unknown (not a git checkout)\n'
  elif $modified; then
    printf 'commit: %s (with local changes)\n' "$commit"
  else
    printf 'commit: %s\n' "$commit"
  fi
fi
exit "$code"
