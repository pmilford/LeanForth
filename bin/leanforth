#!/usr/bin/env bash
# leanforth: LeanForth's command-line tool (plan tasks 3.4.1-3.4.2, v0).
# A small wrapper: it finds Gforth and runs the Forth entry point,
#   gforth src/main.fs -e cli-main COMMAND [OPTION]... [FILE]...
# (src/cli/leanforth.fs), with standard input closed, from any directory;
# file names are taken relative to the current directory.
# Usage: leanforth help; docs/user/COMMAND_LINE.md is the manual.
#
# The engine (owner, 2026-11-11): check, replay and print run on gforth-fast,
# the quick engine, with the same verdicts as Gforth's checking engine
# (make engine-gate compares them on all of Init); --checked runs them on
# gforth, which stops at a stack or memory fault where it happens (about
# 2.4 times slower). --fast is still accepted and changes nothing, except
# when GFORTH is set (see below). count and reexport, which check no
# proof, use gforth-fast (about 3.3 times faster on large exports,
# docs/development/NDJSON_READER.md). With GFORTH unset the engine is the
# pinned one in .tools/gforth of this checkout (scripts/install-gforth.sh),
# else one on PATH. A set GFORTH names the engine and is used as it is (the
# Makefile's tests set it to the checking engine); --fast then looks for
# the gforth-fast in its folder. When no gforth-fast is found, the run
# uses gforth and says so on standard error. The engine's file name is
# passed on in LEANFORTH_ENGINE, for the resource report and the JSON report.
# Exit status: 0 all accepted (or the command done), 1 something rejected,
# 2 unsupported or unknown, 3 a resource limit, 4 malformed input or
# command line, 5 an internal fault, 6 all accepted but some NOT PROVED
# (only with --strict-axioms). The Forth entry point leaves with 100
# plus that code; any other status from Gforth (its own failure, a crash,
# a signal) is an internal fault here, never a verdict.
# For version and the run record, the checkout's git commit is given when
# git can tell it (LEANFORTH_COMMIT, LEANFORTH_MODIFIED).
set -u

# A fork refused (a process limit, `ulimit -u`, which counts every thread of
# the user) ends bash with status 254 and runs this trap: an internal fault,
# said as such, with the user's threads and the limit when the helper has
# been read (scripts/start-limit.sh; review lib-tidy, note 9).
trap 'st=$?; if [ "$st" -eq 254 ]; then
  command -v lf_start_report >/dev/null && lf_start_report "leanforth: internal fault" 254 ||
    printf "leanforth: internal fault: could not start a process: resource limit\n" >&2
  exit 5; fi' EXIT

self=$0
command -v readlink >/dev/null 2>&1 && self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
root=$(cd "$(dirname "$self")/.." && pwd -P) || {
  printf 'leanforth: internal fault: cannot find the LeanForth checkout\n' >&2
  exit 5
}
. "$root/scripts/start-limit.sh"

# Gforth 1.0 loads a start-up file before src/main.fs: the one GFORTH_ENV
# names, else ~/.config/gforthrc0; such a file could define a test hook
# (lib/task.fs's task-cores-test, a planted fault) and change a run, so it
# is turned off (GFORTH_ENV=off, Gforth 1.0's own switch; ~/.config/gforthrc
# is read only by an interactive Gforth, and Gforth 0.7.3 reads neither).
# (set here, before verify below starts its own Gforth runs.)
export GFORTH_ENV=off

# Everything else is the launchers' shared part (scripts/leanforth-run.sh):
# verify, the engine, the files named twice, the commit and the run of the
# whole command line (src/main.fs).
lf_entry=$root/src/main.fs
. "$root/scripts/leanforth-run.sh"
