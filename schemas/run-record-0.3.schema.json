{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pmilford/LeanForth/schemas/run-record-0.3.schema.json",
  "title": "LeanForth run record, schema version 0.3",
  "description": "The evidence of one check of a Lean export by LeanForth's first checker: the input's SHA-256, size and manifest outcome, the Lean and exporter versions its metadata names, the LeanForth commit, the host Forth, the settings, and every declaration's verdict in input order, read after the run from the checked environment the run made, never from another. Written by src/import/run-record.fs and compared with a new run by src/import/run-replay.fs; documented in docs/programming/RUN_RECORDS.md. A record is evidence, not an approval, and never a source of saved results.",
  "$comment": "Uses only the keywords that tests/support/schema_subset.py implements; it refuses any other keyword. Patterns are ECMA-262 regular expressions for the u flag, which schema_subset.py reads as Python regular expressions with ECMA-262's ^, $ and .; characters outside the Basic Multilingual Plane are written as JSON escapes. Texts follow the text rule the owner approved for program receipts 0.2. Lengths are counted in characters, as JSON Schema counts them; the writer applies the same numbers as limits in bytes, which is stricter. JSON Schema sees a number only after it is parsed, so it cannot tell 100000.0 or 1e5 from 100000: the strict loader (load_strict) refuses those spellings and replay compares a number's text; the schema bounds every number to I-JSON's exact range. Tightened in place on 2026-11-03 after the independent review, before any record was published outside the tests. Version 0.3 is version 0.2 (schemas/run-record-0.2.schema.json; plan task 5.2.7: the verdict skipped) without the member label, which the owner withdrew on 2026-11-12 (a [format] change the owner decided: results carry no label), on each accepted declaration; 0.1 and 0.2 are kept unchanged for earlier records; replay compares a record only with one of its own version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "input", "export", "leanforth", "host", "settings",
    "check", "declarations"],
  "properties": {
    "schema": {"const": "leanforth-run-record"},
    "schemaVersion": {"const": "0.3"},
    "input": {"$ref": "#/$defs/input"},
    "export": {"$ref": "#/$defs/export"},
    "leanforth": {"$ref": "#/$defs/leanforth"},
    "host": {"$ref": "#/$defs/host"},
    "settings": {"$ref": "#/$defs/settings"},
    "check": {"$ref": "#/$defs/check"},
    "declarations": {
      "description": "Every declaration of the input, in input order, when the run made its environment; none otherwise.",
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/declaration"}
    }
  },
  "allOf": [
    {
      "description": "Declarations are listed only when the run made its environment, whose mode is then known.",
      "if": {"properties": {"check": {"properties": {"mode": {"const": null}}}}},
      "then": {"properties": {"declarations": {"maxItems": 0}}}
    },
    {
      "description": "An input that was read with its manifest enforced matched that manifest.",
      "if": {"properties": {
        "input": {"properties": {"manifest": {"properties": {"enforced": {"const": true}}}}},
        "check": {"properties": {"read": {"const": "ok"}}}}},
      "then": {"properties": {
        "input": {"properties": {"manifest": {"properties": {"outcome": {"const": "ok"}}}}}}}
    },
    {
      "description": "A run that ended ok made every slot final: no declaration is not-checked.",
      "if": {"properties": {"check": {"properties": {"run": {"const": "ok"}}}}},
      "then": {"properties": {"declarations": {"items": {
        "properties": {"verdict": {"not": {"const": "not-checked"}}}}}}}
    }
  ],
  "$defs": {
    "outcome": {
      "description": "ADR 0008's outcome vocabulary.",
      "enum": ["ok", "invalid", "exhausted", "unknown", "rejected", "unsupported", "full"]
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "signed": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "text": {
      "description": "The text rule of program receipts 0.2: no control characters (Unicode Cc), no format characters (Cf as of Unicode 15.1: bidirectional controls, zero-width characters, tags), no line or paragraph separators and no surrogates, so a text shows what it says and cannot start a new line.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    },
    "shown": {
      "description": "A text with at least one character that is seen: not a space (space, no-break space, Ogham space mark, en quad to hair space, narrow no-break, medium mathematical and ideographic spaces), not a blank-looking filler (U+115F, U+1160, U+2800, U+3164, U+FFA0), not a combining mark (general category M) and not a default-ignorable code point, as of Unicode 15.1; so it is neither empty, blank nor made of marks or ignorable characters alone. Unlike the receipts' rule it does not require an ASCII character: a Lean name may be written in any script. The class is the table tr-unseen of src/lib/text-rule.fs.",
      "allOf": [{"$ref": "#/$defs/text"},
        {"pattern": "[^\\u0020\\u00a0\\u00ad\\u0300-\\u036f\\u0483-\\u0489\\u0591-\\u05bd\\u05bf\\u05c1-\\u05c2\\u05c4-\\u05c5\\u05c7\\u0610-\\u061a\\u061c\\u064b-\\u065f\\u0670\\u06d6-\\u06dc\\u06df-\\u06e4\\u06e7-\\u06e8\\u06ea-\\u06ed\\u0711\\u0730-\\u074a\\u07a6-\\u07b0\\u07eb-\\u07f3\\u07fd\\u0816-\\u0819\\u081b-\\u0823\\u0825-\\u0827\\u0829-\\u082d\\u0859-\\u085b\\u0898-\\u089f\\u08ca-\\u08e1\\u08e3-\\u0903\\u093a-\\u093c\\u093e-\\u094f\\u0951-\\u0957\\u0962-\\u0963\\u0981-\\u0983\\u09bc\\u09be-\\u09c4\\u09c7-\\u09c8\\u09cb-\\u09cd\\u09d7\\u09e2-\\u09e3\\u09fe\\u0a01-\\u0a03\\u0a3c\\u0a3e-\\u0a42\\u0a47-\\u0a48\\u0a4b-\\u0a4d\\u0a51\\u0a70-\\u0a71\\u0a75\\u0a81-\\u0a83\\u0abc\\u0abe-\\u0ac5\\u0ac7-\\u0ac9\\u0acb-\\u0acd\\u0ae2-\\u0ae3\\u0afa-\\u0aff\\u0b01-\\u0b03\\u0b3c\\u0b3e-\\u0b44\\u0b47-\\u0b48\\u0b4b-\\u0b4d\\u0b55-\\u0b57\\u0b62-\\u0b63\\u0b82\\u0bbe-\\u0bc2\\u0bc6-\\u0bc8\\u0bca-\\u0bcd\\u0bd7\\u0c00-\\u0c04\\u0c3c\\u0c3e-\\u0c44\\u0c46-\\u0c48\\u0c4a-\\u0c4d\\u0c55-\\u0c56\\u0c62-\\u0c63\\u0c81-\\u0c83\\u0cbc\\u0cbe-\\u0cc4\\u0cc6-\\u0cc8\\u0cca-\\u0ccd\\u0cd5-\\u0cd6\\u0ce2-\\u0ce3\\u0cf3\\u0d00-\\u0d03\\u0d3b-\\u0d3c\\u0d3e-\\u0d44\\u0d46-\\u0d48\\u0d4a-\\u0d4d\\u0d57\\u0d62-\\u0d63\\u0d81-\\u0d83\\u0dca\\u0dcf-\\u0dd4\\u0dd6\\u0dd8-\\u0ddf\\u0df2-\\u0df3\\u0e31\\u0e34-\\u0e3a\\u0e47-\\u0e4e\\u0eb1\\u0eb4-\\u0ebc\\u0ec8-\\u0ece\\u0f18-\\u0f19\\u0f35\\u0f37\\u0f39\\u0f3e-\\u0f3f\\u0f71-\\u0f84\\u0f86-\\u0f87\\u0f8d-\\u0f97\\u0f99-\\u0fbc\\u0fc6\\u102b-\\u103e\\u1056-\\u1059\\u105e-\\u1060\\u1062-\\u1064\\u1067-\\u106d\\u1071-\\u1074\\u1082-\\u108d\\u108f\\u109a-\\u109d\\u115f-\\u1160\\u135d-\\u135f\\u1680\\u1712-\\u1715\\u1732-\\u1734\\u1752-\\u1753\\u1772-\\u1773\\u17b4-\\u17d3\\u17dd\\u180b-\\u180f\\u1885-\\u1886\\u18a9\\u1920-\\u192b\\u1930-\\u193b\\u1a17-\\u1a1b\\u1a55-\\u1a5e\\u1a60-\\u1a7c\\u1a7f\\u1ab0-\\u1ace\\u1b00-\\u1b04\\u1b34-\\u1b44\\u1b6b-\\u1b73\\u1b80-\\u1b82\\u1ba1-\\u1bad\\u1be6-\\u1bf3\\u1c24-\\u1c37\\u1cd0-\\u1cd2\\u1cd4-\\u1ce8\\u1ced\\u1cf4\\u1cf7-\\u1cf9\\u1dc0-\\u1dff\\u2000-\\u200f\\u202a-\\u202f\\u205f-\\u206f\\u20d0-\\u20f0\\u2800\\u2cef-\\u2cf1\\u2d7f\\u2de0-\\u2dff\\u3000\\u302a-\\u302f\\u3099-\\u309a\\u3164\\ua66f-\\ua672\\ua674-\\ua67d\\ua69e-\\ua69f\\ua6f0-\\ua6f1\\ua802\\ua806\\ua80b\\ua823-\\ua827\\ua82c\\ua880-\\ua881\\ua8b4-\\ua8c5\\ua8e0-\\ua8f1\\ua8ff\\ua926-\\ua92d\\ua947-\\ua953\\ua980-\\ua983\\ua9b3-\\ua9c0\\ua9e5\\uaa29-\\uaa36\\uaa43\\uaa4c-\\uaa4d\\uaa7b-\\uaa7d\\uaab0\\uaab2-\\uaab4\\uaab7-\\uaab8\\uaabe-\\uaabf\\uaac1\\uaaeb-\\uaaef\\uaaf5-\\uaaf6\\uabe3-\\uabea\\uabec-\\uabed\\ufb1e\\ufe00-\\ufe0f\\ufe20-\\ufe2f\\ufeff\\uffa0\\ufff0-\\ufff8\ud800\uddfd\ud800\udee0\ud800\udf76-\ud800\udf7a\ud802\ude01-\ud802\ude03\ud802\ude05-\ud802\ude06\ud802\ude0c-\ud802\ude0f\ud802\ude38-\ud802\ude3a\ud802\ude3f\ud802\udee5-\ud802\udee6\ud803\udd24-\ud803\udd27\ud803\udeab-\ud803\udeac\ud803\udefd-\ud803\udeff\ud803\udf46-\ud803\udf50\ud803\udf82-\ud803\udf85\ud804\udc00-\ud804\udc02\ud804\udc38-\ud804\udc46\ud804\udc70\ud804\udc73-\ud804\udc74\ud804\udc7f-\ud804\udc82\ud804\udcb0-\ud804\udcba\ud804\udcc2\ud804\udd00-\ud804\udd02\ud804\udd27-\ud804\udd34\ud804\udd45-\ud804\udd46\ud804\udd73\ud804\udd80-\ud804\udd82\ud804\uddb3-\ud804\uddc0\ud804\uddc9-\ud804\uddcc\ud804\uddce-\ud804\uddcf\ud804\ude2c-\ud804\ude37\ud804\ude3e\ud804\ude41\ud804\udedf-\ud804\udeea\ud804\udf00-\ud804\udf03\ud804\udf3b-\ud804\udf3c\ud804\udf3e-\ud804\udf44\ud804\udf47-\ud804\udf48\ud804\udf4b-\ud804\udf4d\ud804\udf57\ud804\udf62-\ud804\udf63\ud804\udf66-\ud804\udf6c\ud804\udf70-\ud804\udf74\ud805\udc35-\ud805\udc46\ud805\udc5e\ud805\udcb0-\ud805\udcc3\ud805\uddaf-\ud805\uddb5\ud805\uddb8-\ud805\uddc0\ud805\udddc-\ud805\udddd\ud805\ude30-\ud805\ude40\ud805\udeab-\ud805\udeb7\ud805\udf1d-\ud805\udf2b\ud806\udc2c-\ud806\udc3a\ud806\udd30-\ud806\udd35\ud806\udd37-\ud806\udd38\ud806\udd3b-\ud806\udd3e\ud806\udd40\ud806\udd42-\ud806\udd43\ud806\uddd1-\ud806\uddd7\ud806\uddda-\ud806\udde0\ud806\udde4\ud806\ude01-\ud806\ude0a\ud806\ude33-\ud806\ude39\ud806\ude3b-\ud806\ude3e\ud806\ude47\ud806\ude51-\ud806\ude5b\ud806\ude8a-\ud806\ude99\ud807\udc2f-\ud807\udc36\ud807\udc38-\ud807\udc3f\ud807\udc92-\ud807\udca7\ud807\udca9-\ud807\udcb6\ud807\udd31-\ud807\udd36\ud807\udd3a\ud807\udd3c-\ud807\udd3d\ud807\udd3f-\ud807\udd45\ud807\udd47\ud807\udd8a-\ud807\udd8e\ud807\udd90-\ud807\udd91\ud807\udd93-\ud807\udd97\ud807\udef3-\ud807\udef6\ud807\udf00-\ud807\udf01\ud807\udf03\ud807\udf34-\ud807\udf3a\ud807\udf3e-\ud807\udf42\ud80d\udc40\ud80d\udc47-\ud80d\udc55\ud81a\udef0-\ud81a\udef4\ud81a\udf30-\ud81a\udf36\ud81b\udf4f\ud81b\udf51-\ud81b\udf87\ud81b\udf8f-\ud81b\udf92\ud81b\udfe4\ud81b\udff0-\ud81b\udff1\ud82f\udc9d-\ud82f\udc9e\ud82f\udca0-\ud82f\udca3\ud833\udf00-\ud833\udf2d\ud833\udf30-\ud833\udf46\ud834\udd65-\ud834\udd69\ud834\udd6d-\ud834\udd82\ud834\udd85-\ud834\udd8b\ud834\uddaa-\ud834\uddad\ud834\ude42-\ud834\ude44\ud836\ude00-\ud836\ude36\ud836\ude3b-\ud836\ude6c\ud836\ude75\ud836\ude84\ud836\ude9b-\ud836\ude9f\ud836\udea1-\ud836\udeaf\ud838\udc00-\ud838\udc06\ud838\udc08-\ud838\udc18\ud838\udc1b-\ud838\udc21\ud838\udc23-\ud838\udc24\ud838\udc26-\ud838\udc2a\ud838\udc8f\ud838\udd30-\ud838\udd36\ud838\udeae\ud838\udeec-\ud838\udeef\ud839\udcec-\ud839\udcef\ud83a\udcd0-\ud83a\udcd6\ud83a\udd44-\ud83a\udd4a\udb40\udc00-\udb43\udfff]"}]
    },
    "note": {
      "description": "A text of at most 128 bytes, possibly empty.",
      "allOf": [{"$ref": "#/$defs/text"}, {"pattern": "^.{0,128}$"}]
    },
    "short": {
      "description": "A shown text of at most 128 bytes.",
      "allOf": [{"$ref": "#/$defs/shown"}, {"pattern": "^.{1,128}$"}]
    },
    "maybeShort": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/short"}]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "lines", "manifest"],
      "properties": {
        "sha256": {
          "description": "SHA-256 of the file's bytes, as sha256sum prints it.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {"$ref": "#/$defs/count"},
        "lines": {
          "description": "Line feeds, and one more when the last line has none.",
          "$ref": "#/$defs/count"
        },
        "manifest": {
          "description": "The outcome of checking the file against the manifest beside it (src/import/manifest.fs), recorded whatever it is; field and reason are empty for ok. enforced: true only when the importer refused to load the input unless it matched that manifest (the command line's default; false with --no-manifest, from tests/support/run-records.fs and from any other importer).",
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "field", "reason", "enforced"],
          "properties": {
            "outcome": {"$ref": "#/$defs/outcome"},
            "field": {"$ref": "#/$defs/note"},
            "reason": {"$ref": "#/$defs/note"},
            "enforced": {"type": "boolean"}
          },
          "if": {"properties": {"outcome": {"const": "ok"}}},
          "then": {"properties": {"field": {"const": ""}, "reason": {"const": ""}}},
          "else": {"properties": {"reason": {"$ref": "#/$defs/short"}}}
        }
      }
    },
    "export": {
      "description": "The versions the export's metadata record names; null when no metadata record was read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["exporter", "exporterVersion", "format", "lean", "leanGithash"],
      "properties": {
        "exporter": {"$ref": "#/$defs/maybeShort"},
        "exporterVersion": {"$ref": "#/$defs/maybeShort"},
        "format": {"$ref": "#/$defs/maybeShort"},
        "lean": {"$ref": "#/$defs/maybeShort"},
        "leanGithash": {"$ref": "#/$defs/maybeShort"}
      }
    },
    "leanforth": {
      "description": "The LeanForth commit the run used and whether the working tree differed from it; both null when the caller named none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "modified"],
      "properties": {
        "commit": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]
        },
        "modified": {"type": ["null", "boolean"]}
      },
      "if": {"properties": {"commit": {"type": "null"}}},
      "then": {"properties": {"modified": {"type": "null"}}},
      "else": {"properties": {"modified": {"type": "boolean"}}}
    },
    "host": {
      "description": "The Forth system that ran the check: its name, version and engine (the program's file name) where the host reports them, else unknown, and its cell width.",
      "type": "object",
      "additionalProperties": false,
      "required": ["forth", "version", "engine", "cellBits"],
      "properties": {
        "forth": {"$ref": "#/$defs/short"},
        "version": {"$ref": "#/$defs/short"},
        "engine": {"$ref": "#/$defs/short"},
        "cellBits": {"type": "integer", "minimum": 32, "maximum": 4096}
      }
    },
    "settings": {
      "description": "Fuel for each check, the environment's room for dependencies, and the checker's fixed capacities.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fuel", "dependencyPool", "terms", "levels", "names", "declarations",
        "dependenciesPerCheck", "parameters", "referenceLevels"],
      "properties": {
        "fuel": {"$ref": "#/$defs/count"},
        "dependencyPool": {"$ref": "#/$defs/count"},
        "terms": {"$ref": "#/$defs/count"},
        "levels": {"$ref": "#/$defs/count"},
        "names": {"$ref": "#/$defs/count"},
        "declarations": {"$ref": "#/$defs/count"},
        "dependenciesPerCheck": {"$ref": "#/$defs/count"},
        "parameters": {"$ref": "#/$defs/count"},
        "referenceLevels": {"$ref": "#/$defs/count"}
      }
    },
    "check": {
      "description": "The importer's outcome, the run's (not-run when the input was not read), and the run mode and axiom allowlist version of the environment the run made: final and 0 in the first checker, null when it made none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "run", "mode", "allowlistVersion"],
      "properties": {
        "read": {"$ref": "#/$defs/outcome"},
        "run": {"anyOf": [{"$ref": "#/$defs/outcome"}, {"const": "not-run"}]},
        "mode": {"enum": [null, "final"]},
        "allowlistVersion": {"enum": [null, 0, 1]}
      },
      "allOf": [
        {
          "if": {"properties": {"read": {"const": "ok"}}},
          "then": {"properties": {"run": {"$ref": "#/$defs/outcome"}}},
          "else": {"properties": {"run": {"const": "not-run"}}}
        },
        {
          "if": {"properties": {"mode": {"const": null}}},
          "then": {"properties": {"allowlistVersion": {"const": null}}},
          "else": {"properties": {"allowlistVersion": {"enum": [0, 1]}}}
        },
        {
          "if": {"properties": {"run": {"const": "not-run"}}},
          "then": {"properties": {"mode": {"const": null}}}
        },
        {
          "if": {"properties": {"run": {"const": "ok"}}},
          "then": {"properties": {"mode": {"const": "final"}}}
        }
      ]
    },
    "diagnostic": {
      "description": "What the failed check recorded: the reason code and its name (docs/programming/DIAGNOSTICS.md), the site (module and word, at most 255 bytes, or empty), its two numbers and the step of check-declaration it reached.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "site", "numbers", "step"],
      "properties": {
        "code": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "reason": {"$ref": "#/$defs/short"},
        "site": {
          "anyOf": [{"const": ""},
            {"allOf": [{"$ref": "#/$defs/shown"}, {"pattern": "^.{1,255}$"}]}]
        },
        "numbers": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/signed"}},
        "step": {"$ref": "#/$defs/count"}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "verdict"],
      "properties": {
        "index": {
          "description": "The declaration's position in the input, counted from 0; replay checks that it matches.",
          "$ref": "#/$defs/count"
        },
        "name": {
          "description": "The declaration's name as the term printer writes it: a shown text of at most 1024 bytes.",
          "allOf": [{"$ref": "#/$defs/shown"}, {"pattern": "^.{1,1024}$"}]
        },
        "verdict": {
          "description": "accepted only for a slot made final with outcome ok; skipped for a rejected slot of an unsafe or partial declaration, which Lean's replay skips unchecked and nothing can use (plan task 5.2.7); invalid also for a slot whose check began but did not end final; not-checked for a slot the run never reached.",
          "enum": ["accepted", "skipped", "rejected", "unknown", "unsupported", "invalid",
            "exhausted", "full", "not-checked"]
        },
        "axioms": {
          "description": "The axioms the accepted declaration depends on, read from the slots, in file order: each name as the term printer writes it. Allowlist version 0 had none; version 1 (src/core/axiom-allowlist.fs) lists propext, Classical.choice and Quot.sound with Lean's statements as proved, and any other axiom makes the declaration NOT PROVED.",
          "type": "array",
          "items": {"allOf": [{"$ref": "#/$defs/shown"}, {"pattern": "^.{1,1024}$"}]}
        },
        "diagnostic": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/diagnostic"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "accepted"}}},
          "then": {"required": ["axioms"], "not": {"required": ["diagnostic"]}},
          "else": {"not": {"anyOf": [{"required": ["axioms"]}]}}
        },
        {
          "if": {"properties": {"verdict": {"enum": ["accepted", "not-checked"]}}},
          "then": {"not": {"required": ["diagnostic"]}},
          "else": {"required": ["diagnostic"]}
        }
      ]
    }
  }
}
